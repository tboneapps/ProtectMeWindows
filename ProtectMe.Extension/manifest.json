{
  "manifest_version": 3,
  "name": "ProtectMe Companion",
  "version": "1.1.0",
  "description": "Instant Safe Browsing and in-tab Website Protection sync for ProtectMe on Windows.",
  "icons": {
    "128": "icon.png"
  },
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
