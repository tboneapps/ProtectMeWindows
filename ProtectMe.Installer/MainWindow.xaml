<Window x:Class="ProtectMe.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProtectMe Setup"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0A0A0A">
    <Border Margin="18" CornerRadius="22" BorderBrush="#66D4AF37" BorderThickness="1.2" Padding="24">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1C180F" Offset="0"/>
                <GradientStop Color="#0E0E0E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,18">
                <Image Source="pack://application:,,,/protectme_icon.png" Width="74" Height="74" Margin="0,0,0,10"/>
                <TextBlock Text="P R O T E C T M E" FontSize="22" FontWeight="SemiBold" Foreground="#E5C158" HorizontalAlignment="Center"/>
                <TextBlock Text="Windows Setup" FontSize="12" Foreground="#8C8472" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="PERMISSIONS REQUIRED" Foreground="#B9A673" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="#0A0A0A" BorderBrush="#25221D" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel>
                        <TextBlock Text="✓  Install protected files to Program Files" Foreground="#F3E7C4" FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock Text="✓  LocalSystem Windows Service (anti-tamper)" Foreground="#F3E7C4" FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock Text="✓  Auto-recovery watchdog &amp; locked service DACL" Foreground="#F3E7C4" FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock Text="✓  System Proxy for Website Whitelist protection" Foreground="#F3E7C4" FontSize="12"/>
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="InstallProgress" Height="6" Margin="0,18,0,8" Minimum="0" Maximum="100" Value="0" Background="#181818" Foreground="#D4AF37" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" Text="Ready to install ProtectMe on this PC." Foreground="#8C8472" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>

            <Button x:Name="ActionButton" Grid.Row="2" Content="Grant Permissions &amp; Install" Height="48" Margin="0,16,0,0" Cursor="Hand" FontWeight="Bold" FontSize="14" Foreground="#0A0A0A" Click="ActionButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F0CE63" Offset="0"/>
                                    <GradientStop Color="#C99F2B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
