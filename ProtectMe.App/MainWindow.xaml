                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="TURN ON AT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetTimeAtBox" Text="23:00" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoldLightBrush}" FontFamily="{StaticResource CinzelFont}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" LostFocus="SaveSchedule_LostFocus"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="EVERY DAY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="🔑  You'll need a key to turn it off" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- WEEKLY Section Label -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="#25221D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="W E E K L Y" Foreground="{StaticResource LabelGoldBrush}" FontSize="11" FontWeight="ExtraBold"/>
                            <Border Grid.Column="2" Height="1" Background="#25221D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- WEEKLY Card -->
                        <Border x:Name="WeeklyCard" Style="{StaticResource PmCard}" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#1D1910" BorderBrush="#3B321F" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="📅" FontSize="16" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Weekly schedule" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14"/>
