                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <CheckBox x:Name="SetTimeToggle" Style="{StaticResource GoldToggleSwitch}" Click="SetTimeToggle_Click"/>
                                        <TextBlock x:Name="SetTimeStateLabel" Text="OFF" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
