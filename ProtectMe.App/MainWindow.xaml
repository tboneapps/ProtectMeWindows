                        <Border x:Name="TrialBanner" Background="#1A160D" BorderBrush="#55D4AF37" BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="0,0,0,14">
                            <Grid>
                                <TextBlock x:Name="TrialBannerText" Text="7-Day Free Trial · 7 days left" Foreground="{StaticResource GoldLightBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
