                    </StackPanel>

                    <!-- SUB-VIEW: SCHEDULE (Exact ProtectMe Android: SET TIME + WEEKLY, Mutually Exclusive) -->
                    <StackPanel x:Name="ScheduleSubView" Visibility="Collapsed">
