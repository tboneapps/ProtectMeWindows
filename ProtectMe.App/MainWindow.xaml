<Window x:Class="ProtectMe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProtectMe"
        Icon="pack://application:,,,/Assets/Images/protectme_icon.png"
        Width="410" Height="780"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <!-- Subtle Gold Ambience Backdrop across the entire app -->
        <Ellipse Grid.RowSpan="3"
                 Width="540" Height="420"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center"
                 Margin="0,-160,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#22D4AF37" Offset="0.0"/>
                    <GradientStop Color="#0BD4AF37" Offset="0.55"/>
                    <GradientStop Color="#000A0A0A" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Top Header (Hidden on Home; matches ProtectMe Android "K E Y S" + gold diamond ornament) -->
        <StackPanel Grid.Row="0">
            <!-- In-App Update Available Banner (Only visible when a newer GitHub release is found) -->
            <Border x:Name="UpdateBanner" Background="#241D0E" BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,0,0,1" Padding="14,8" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="UpdateBannerText" Text="Update available" Foreground="{StaticResource GoldLightBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="UpdateNowBtn" Content="Update Now" HorizontalAlignment="Right" Style="{StaticResource GoldButton}" Padding="12,5" FontSize="11" Click="UpdateNowBtn_Click"/>
                </Grid>
            </Border>

            <StackPanel x:Name="TopHeader" Margin="0,24,0,10" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="PageHeaderTitle"
                       Text="P A S S W O R D"
                       FontFamily="{StaticResource CinzelFont}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TitleGradientBrush}"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Border Width="48" Height="1" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00D4AF37" Offset="0"/>
                            <GradientStop Color="#AAD4AF37" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Rectangle Width="6" Height="6" Fill="{StaticResource GoldBrush}" Margin="10,0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Border Width="48" Height="1" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#AAD4AF37" Offset="0"/>
                            <GradientStop Color="#00D4AF37" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- PAGE 1: PROTECTME HOME (Exact Match to ProtectMe Android Screenshots) -->
            <Grid x:Name="HomePanel" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">

                    <!-- Center ProtectMe Android Logo Tile + Animated Gold Ambient Glow (when ON) -->
                    <Grid Width="280" Height="280" HorizontalAlignment="Center">
                        <!-- Animated Pulsing Gold Glow Behind Logo (visible when PROTECTED) -->
                        <Ellipse x:Name="GoldAuraEllipse"
                                 Width="280" Height="280"
                                 Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="GoldAuraScale" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#66D4AF37" Offset="0.0"/>
                                    <GradientStop Color="#2AD4AF37" Offset="0.55"/>
                                    <GradientStop Color="#000A0A0A" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Rounded Black Square Logo Tile (Tap to turn OFF when PROTECTED) -->
                        <Border x:Name="LogoButtonTile"
                                Width="206" Height="206"
                                CornerRadius="42"
                                Background="#000000"
                                Cursor="Hand"
                                MouseLeftButtonDown="LogoTile_MouseDown"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LogoTileScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Image x:Name="CenterLogoImage"
                                   Width="168" Height="168"
                                   Stretch="Uniform"/>
                        </Border>
                    </Grid>

                    <!-- Status Title: UNPROTECTED / PROTECTED -->
                    <TextBlock x:Name="HoldHintTitle"
                               Text="U N P R O T E C T E D"
                               FontFamily="{StaticResource CinzelFont}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,8"/>

                    <!-- Subtitle (Visible when PROTECTED: "Press to turn off") -->
                    <TextBlock x:Name="HoldHintSubtitle"
                               Text="Press to turn off"
                               FontFamily="{StaticResource ManropeFont}"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"
                               Margin="0,0,0,18"/>

                    <!-- "Hold to Protect" Animated Pill Button (Visible when UNPROTECTED) -->
                    <Border x:Name="HoldPillButton"
                            Height="56"
                            Width="310"
                            CornerRadius="28"
                            Background="#1B170E"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1.6"
                            ClipToBounds="True"
                            Cursor="Hand"
                            Margin="0,24,0,0"
                            MouseLeftButtonDown="HoldPill_MouseDown"
                            MouseLeftButtonUp="HoldPill_MouseUp"
                            MouseLeave="HoldPill_MouseLeave">
                        <Grid>
                            <!-- Animated Gold Fill Bar sweeping left-to-right while holding -->
                            <Border x:Name="HoldPillFill"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    CornerRadius="28"
                                    Background="{StaticResource GoldGradientBrush}"
                                    Opacity="0.88"/>
                            <TextBlock x:Name="HoldPillText"
                                       Text="Hold to Protect"
                                       FontFamily="{StaticResource ManropeFont}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldLightBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Service Warning (only if not installed yet) -->
                    <Border x:Name="ServiceWarningCard" Style="{StaticResource PmCard}" Background="#1A0F0E" BorderBrush="#3A2220" Padding="12" Margin="16,24,16,0" Visibility="Collapsed">
                        <TextBlock Text="SYSTEM service not running — run Install-ProtectMe-Tablet.bat as Administrator."
                                   Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PAGE 2: PASSWORD OR PIN (Polished 24K Gold Ambience, Show/Hide Eye, Confirm Twice) -->
            <ScrollViewer x:Name="PasswordPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20,6,20,16">
                <StackPanel>
                    <!-- 24K Gold Ambience Password / PIN Card -->
                    <Border Style="{StaticResource PmCard}" BorderBrush="#66D4AF37" Padding="20" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#231D11" Offset="0"/>
                                <GradientStop Color="#110F0B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <!-- Card Header + Active Status Pill -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11" Background="#1F1A10" BorderBrush="#66D4AF37" BorderThickness="1" Margin="0,0,12,0">
                                    <TextBlock Text="🔑" FontSize="17" Foreground="{StaticResource GoldLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Unlock Key" Foreground="{StaticResource GoldLightBrush}" FontFamily="{StaticResource ManropeFont}" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock x:Name="PasswordStatusText" Text="No password or PIN set yet." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                                <Border x:Name="PasswordStatusPill" Grid.Column="2" Background="#1B1914" BorderBrush="#332E24" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="PasswordStatusPillText" Text="OFF" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="ExtraBold"/>
                                </Border>
                            </Grid>

                            <!-- Mode Switcher: Password | PIN -->
                            <Border Background="#0A0A0A" BorderBrush="#25221D" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ModePasswordBtn" Grid.Column="0" Content="Password" Style="{StaticResource GoldButton}" Padding="8,7" FontSize="12" Click="ModePassword_Click"/>
                                    <Button x:Name="ModePinBtn" Grid.Column="1" Content="PIN (Digits)" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource ManropeFont}" FontWeight="SemiBold" FontSize="12" Padding="8,7" Cursor="Hand" Click="ModePin_Click"/>
                                </Grid>
                            </Border>

                            <!-- Current Password / PIN (shown only if already set) -->
                            <StackPanel x:Name="CurrentPwPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock x:Name="CurrentPwLabel" Text="CURRENT PASSWORD" Foreground="{StaticResource LabelGoldBrush}" FontSize="10" FontWeight="ExtraBold" Margin="0,0,0,5"/>
                                <Grid>
                                    <PasswordBox x:Name="CurrentPwBox" Background="#0A0A0A" Foreground="#F3E7C4" CaretBrush="#D4AF37" BorderBrush="#2A251C" BorderThickness="1" Padding="12,10,40,10" FontSize="14"/>
                                    <TextBox x:Name="CurrentPwPlain" Visibility="Collapsed" Style="{StaticResource PmTextBox}" Padding="12,10,40,10" FontSize="14"/>
                                    <Button Content="👁" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoldBrush}" FontSize="14" Padding="10,0" Cursor="Hand" Click="ToggleShowPw_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- New Password / PIN -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock x:Name="NewPwLabel" Text="NEW PASSWORD" Foreground="{StaticResource LabelGoldBrush}" FontSize="10" FontWeight="ExtraBold" Margin="0,0,0,5"/>
                                <Grid>
                                    <PasswordBox x:Name="NewPwBox" Background="#0A0A0A" Foreground="#F3E7C4" CaretBrush="#D4AF37" BorderBrush="#2A251C" BorderThickness="1" Padding="12,10,40,10" FontSize="14" PasswordChanged="PwField_Changed"/>
                                    <TextBox x:Name="NewPwPlain" Visibility="Collapsed" Style="{StaticResource PmTextBox}" Padding="12,10,40,10" FontSize="14" TextChanged="PwPlain_Changed"/>
                                    <Button Content="👁" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoldBrush}" FontSize="14" Padding="10,0" Cursor="Hand" Click="ToggleShowPw_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Confirm New Password / PIN -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock x:Name="ConfirmPwLabel" Text="CONFIRM PASSWORD" Foreground="{StaticResource LabelGoldBrush}" FontSize="10" FontWeight="ExtraBold" Margin="0,0,0,5"/>
                                <Grid>
                                    <PasswordBox x:Name="ConfirmPwBox" Background="#0A0A0A" Foreground="#F3E7C4" CaretBrush="#D4AF37" BorderBrush="#2A251C" BorderThickness="1" Padding="12,10,40,10" FontSize="14" PasswordChanged="PwField_Changed"/>
                                    <TextBox x:Name="ConfirmPwPlain" Visibility="Collapsed" Style="{StaticResource PmTextBox}" Padding="12,10,40,10" FontSize="14" TextChanged="PwPlain_Changed"/>
                                    <Button Content="👁" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoldBrush}" FontSize="14" Padding="10,0" Cursor="Hand" Click="ToggleShowPw_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Live Match / Validation Feedback -->
                            <TextBlock x:Name="PwValidationText" Text="" FontSize="11.5" FontWeight="SemiBold" Margin="2,0,0,14" MinHeight="16"/>

                            <Button x:Name="SavePasswordBtn" Content="Save Password" Style="{StaticResource GoldButton}" Click="SavePasswordForm_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Small Red Uninstall Button at Bottom -->
                    <Button Content="Uninstall ProtectMe"
                            Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Center"
                            Padding="22,9"
                            FontSize="12"
                            Margin="0,4,0,8"
                            Click="Uninstall_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 3: RULES (Exact Match to ProtectMe Android: Blocked apps | Apps offline | Schedule) -->
            <ScrollViewer x:Name="AppsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20,10">
                <StackPanel>
                    <!-- RULES HUB VIEW -->
                    <StackPanel x:Name="RulesHubView" Visibility="Visible">
                        <!-- Auto-Block Newly Installed Apps Card (Top, Default ON) -->
                        <Border Style="{StaticResource PmCard}" Padding="16" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Block newly installed apps" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="New apps can install, then auto-add to Blocked" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="BlockNewAppsToggle" Grid.Column="1" Style="{StaticResource GoldToggleSwitch}" Click="BlockNewAppsToggle_Click"/>
                            </Grid>
                        </Border>

                        <!-- BLOCK APPS Section Label -->
                        <Grid Margin="0,4,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="#2A261E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="B L O C K   A P P S" Foreground="{StaticResource LabelGoldBrush}" FontSize="11" FontWeight="ExtraBold"/>
                            <Border Grid.Column="2" Height="1" Background="#2A261E" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Two Side-by-Side Cards: Blocked apps | Apps offline -->
                        <Grid Margin="0,0,0,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Blocked apps card -->
                            <Border Grid.Column="0" Style="{StaticResource PmCard}" BorderBrush="#4AD4AF37" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#1D1910" BorderBrush="#3B321F" BorderThickness="1" Margin="0,4,0,12">
                                        <TextBlock Text="⊘" FontSize="20" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Blocked apps" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BlockedAppsCountText" Text="0 apps" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                                    <Button Content="Manage" Style="{StaticResource OutlineGoldButton}" Padding="24,8" FontSize="13" Click="OpenBlockedApps_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Apps offline card -->
                            <Border Grid.Column="2" Style="{StaticResource PmCard}" BorderBrush="#4AD4AF37" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#1D1910" BorderBrush="#3B321F" BorderThickness="1" Margin="0,4,0,12">
                                        <TextBlock Text="📡" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Apps offline" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="OfflineAppsCountText" Text="0 apps" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                                    <Button Content="Manage" Style="{StaticResource OutlineGoldButton}" Padding="24,8" FontSize="13" Click="OpenOfflineApps_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- SCHEDULE Section Label -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="#2A261E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="S C H E D U L E" Foreground="{StaticResource LabelGoldBrush}" FontSize="11" FontWeight="ExtraBold"/>
                            <Border Grid.Column="2" Height="1" Background="#2A261E" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Schedule Row Card -->
                        <Border Style="{StaticResource PmCard}" Padding="16" Cursor="Hand" MouseLeftButtonDown="OpenSchedule_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#1D1910" BorderBrush="#3B321F" BorderThickness="1" Margin="0,0,14,0">
                                    <TextBlock Text="📅" FontSize="16" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Schedule" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock x:Name="ScheduleSummaryText" Text="Off" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="22" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- SUB-VIEW: BLOCKED APPS (Exact ProtectMe Android Icon Grid + Blocked Tray) -->
                    <StackPanel x:Name="BlockedAppsSubView" Visibility="Collapsed">
                        <!-- Back + Search Bar -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="‹" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoldBrush}" FontSize="28" Padding="4,0,14,4" Cursor="Hand" Click="BackToRules_Click"/>
                            <Border Grid.Column="1" Background="#111111" BorderBrush="#25221D" BorderThickness="1" CornerRadius="14" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="AppSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkBrush}" CaretBrush="{StaticResource GoldBrush}" FontSize="13" VerticalAlignment="Center" TextChanged="AppSearchBox_TextChanged"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Gold-Bordered BLOCKED Tray Card -->
                        <Border CornerRadius="20" BorderBrush="#66D4AF37" BorderThickness="1" Padding="16" Margin="0,0,0,18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#221C10" Offset="0"/>
                                    <GradientStop Color="#110F0B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="B L O C K E D" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="ExtraBold"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="{StaticResource GoldGradientBrush}" CornerRadius="12" Padding="12,4">
                                        <TextBlock x:Name="BlockedTrayCountPill" Text="0 apps" Foreground="#0A0A0A" FontSize="11" FontWeight="ExtraBold"/>
                                    </Border>
                                </Grid>

                                <ItemsControl x:Name="BlockedTrayItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,10" Tag="{Binding}" Click="UnblockAppTile_Click">
                                                <Grid Width="52" Height="52">
                                                    <Border Width="48" Height="48" CornerRadius="24" Background="#161410" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                        <Grid>
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource GoldLightBrush}" FontSize="9" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4"/>
                                                            <Image Source="{Binding ExecutablePath, Converter={StaticResource ExeToIconConverter}}" Width="32" Height="32" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border Width="18" Height="18" CornerRadius="9" Background="#2A1210" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <TextBlock Text="×" Foreground="{StaticResource DangerBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="#2B2418" Margin="0,6,0,10"/>
                                <TextBlock Text="Tap an app to unblock it" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Section Divider: ADD TO BLOCKED · N -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="#25221D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AddToBlockedHeader" Grid.Column="1" Text="ADD TO BLOCKED · 0" Foreground="{StaticResource LabelGoldBrush}" FontSize="11" FontWeight="ExtraBold"/>
                            <Border Grid.Column="2" Height="1" Background="#25221D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- 4-Column Circular App Icon Grid with Gold + Badge -->
                        <ItemsControl x:Name="UnblockedGridItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0,4,14" Tag="{Binding}" Click="BlockAppTile_Click">
                                        <StackPanel HorizontalAlignment="Center" Width="76">
                                            <Grid Width="56" Height="56" HorizontalAlignment="Center">
                                                <Border Width="52" Height="52" CornerRadius="26" Background="#171717" BorderBrush="#4AD4AF37" BorderThickness="1.2">
                                                    <Grid>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource InkBrush}" FontSize="9" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="5"/>
                                                        <Image Source="{Binding ExecutablePath, Converter={StaticResource ExeToIconConverter}}" Width="34" Height="34" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource GoldGradientBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
