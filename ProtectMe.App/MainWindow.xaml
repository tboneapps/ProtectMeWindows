                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 4: WEBSITES (Hub with Safe Browsing + Website Protection + 2 Manage Cards: Websites | Webpages) -->
            <ScrollViewer x:Name="WebsitesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20,10">
                <StackPanel>
