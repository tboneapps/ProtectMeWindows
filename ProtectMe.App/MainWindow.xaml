                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PmCard}" BorderBrush="#4AD4AF37" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#1D1910" BorderBrush="#3B321F" BorderThickness="1" Margin="0,4,0,12">
                                        <TextBlock Text="📄" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Webpages" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="WhitelistPagesCountText" Text="0 pages" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                                    <Button Content="Manage" Style="{StaticResource OutlineGoldButton}" Padding="24,8" FontSize="13" Click="OpenWhitelistPages_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- SUB-VIEW: MANAGE WHITELISTED WEBSITES -->
                    <StackPanel x:Name="WhitelistWebsitesSubView" Visibility="Collapsed">
                        <Button Content="‹  Back to Websites" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoldBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" Padding="0,0,0,12" Cursor="Hand" Click="BackToWebsites_Click"/>
                        <Border Style="{StaticResource PmCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ADD ALLOWED WEBSITE" Foreground="{StaticResource LabelGoldBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewSiteInput" Grid.Column="0" Style="{StaticResource PmTextBox}" ToolTip="e.g. wikipedia.org"/>
                                    <Button Grid.Column="2" Content="Allow" Style="{StaticResource GoldButton}" Padding="16,10" Click="AddWholeWebsite_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="WhitelistWebsitesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A0A0A" BorderBrush="#25221D" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand" Tag="{Binding Value}" Click="OpenWhitelistLink_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🌐" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource GoldLightBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  ↗" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Content="×" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="13" Tag="{Binding Id}" Click="RemoveWhitelist_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- SUB-VIEW: MANAGE WHITELISTED WEBPAGES -->
                    <StackPanel x:Name="WhitelistPagesSubView" Visibility="Collapsed">
                        <Button Content="‹  Back to Websites" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoldBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" Padding="0,0,0,12" Cursor="Hand" Click="BackToWebsites_Click"/>
                        <Border Style="{StaticResource PmCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ADD ALLOWED WEBPAGE URL" Foreground="{StaticResource LabelGoldBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewPageInput" Grid.Column="0" Style="{StaticResource PmTextBox}" ToolTip="e.g. https://example.com/specific-page"/>
                                    <Button Grid.Column="2" Content="Allow" Style="{StaticResource GoldButton}" Padding="16,10" Click="AddSpecificWebpage_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="WhitelistPagesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A0A0A" BorderBrush="#25221D" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand" Tag="{Binding Value}" Click="OpenWhitelistLink_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📄" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource GoldLightBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  ↗" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Content="×" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="13" Tag="{Binding Id}" Click="RemoveWhitelist_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom 4-Tab Navigation Bar (Polished Centered Vector Icons + Gold Active Dot) -->
        <Border Grid.Row="2" Background="#0D0D0D" BorderBrush="#25221D" BorderThickness="0,1,0,0">
            <UniformGrid Columns="4">
                <!-- Tab 0: ProtectMe (Shield) -->
                <Button x:Name="NavHome" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GoldBrush}" Cursor="Hand" Click="NavHome_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Path Data="M12,2 L4,5.5 V11.5 C4,16.8 7.4,21.6 12,23 C16.6,21.6 20,16.8 20,11.5 V5.5 L12,2 Z"
                                  Stroke="{Binding Foreground, ElementName=NavHome}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="ProtectMe" FontFamily="{StaticResource ManropeFont}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                        <Ellipse x:Name="DotHome" Width="4" Height="4" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Visible"/>
                    </StackPanel>
                </Button>

                <!-- Tab 1: Password (Key) -->
                <Button x:Name="NavPassword" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Cursor="Hand" Click="NavPassword_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Path Data="M7.5,14.5 A4.5,4.5 0 1,1 11.7,10 H21 V13 H19 V15 H16 V13 H11.7 A4.5,4.5 0 0,1 7.5,14.5 Z"
                                  Stroke="{Binding Foreground, ElementName=NavPassword}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Password" FontFamily="{StaticResource ManropeFont}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                        <Ellipse x:Name="DotPassword" Width="4" Height="4" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Hidden"/>
                    </StackPanel>
                </Button>

                <!-- Tab 2: Rules (Checklist) -->
                <Button x:Name="NavApps" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Cursor="Hand" Click="NavApps_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Path Data="M4,7 L6.5,9.5 L10,5.5 M13,7.5 H20 M4,15.5 L6.5,18 L10,14 M13,16 H20"
                                  Stroke="{Binding Foreground, ElementName=NavApps}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Rules" FontFamily="{StaticResource ManropeFont}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                        <Ellipse x:Name="DotRules" Width="4" Height="4" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Hidden"/>
                    </StackPanel>
                </Button>

                <!-- Tab 3: Websites (Globe) -->
                <Button x:Name="NavWebsites" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Cursor="Hand" Click="NavWebsites_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M2.5,12 H21.5 M12,2 C15,5 15,19 12,22 M12,2 C9,5 9,19 12,22"
                                  Stroke="{Binding Foreground, ElementName=NavWebsites}" StrokeThickness="1.7" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Websites" FontFamily="{StaticResource ManropeFont}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                        <Ellipse x:Name="DotWebsites" Width="4" Height="4" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Hidden"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
