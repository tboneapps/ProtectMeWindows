                                    <Button x:Name="DayBtn1" Content="T" Tag="1" Width="34" Height="34" Click="DayBtn_Click"/>
                                    <Button x:Name="DayBtn2" Content="W" Tag="2" Width="34" Height="34" Click="DayBtn_Click"/>
