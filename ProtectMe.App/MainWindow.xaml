                        </Grid>

                        <!-- SET TIME Card -->
                        <Border x:Name="SetTimeCard" Style="{StaticResource PmCard}" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#1D1910" BorderBrush="#3B321F" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="🕒" FontSize="16" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Turn on at a set time" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14"/>
