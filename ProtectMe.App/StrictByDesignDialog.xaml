<Window x:Class="ProtectMe.App.StrictByDesignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strict by Design"
        Width="370" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="24" BorderBrush="#88D4AF37" BorderThickness="1.3" Padding="24">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#241E12" Offset="0"/>
                <GradientStop Color="#0E0E0E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <Image Source="pack://application:,,,/Assets/Images/protectme_icon.png" Width="62" Height="62" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Text="S T R I C T   B Y   D E S I G N"
                       FontFamily="{StaticResource CinzelFont}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TitleGradientBrush}"
                       HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,16">
                <Border Width="38" Height="1" Background="#66D4AF37" VerticalAlignment="Center"/>
                <Rectangle Width="5" Height="5" Fill="{StaticResource GoldBrush}" Margin="8,0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                </Rectangle>
                <Border Width="38" Height="1" Background="#66D4AF37" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Once you set a password, ProtectMe can't be turned off or uninstalled without it."
                       Foreground="{StaticResource InkBrush}" Opacity="0.86" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="6,0,6,10"/>

            <TextBlock Text="Try it first with no password."
                       Foreground="{StaticResource GoldLightBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <Border Background="#11100C" BorderBrush="#2E281C" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="1.  Turn protection on" Foreground="{StaticResource InkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="2.  Try to uninstall ProtectMe" Foreground="{StaticResource InkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Foreground="{StaticResource InkBrush}" FontSize="13">
                        <Run Text="3.  Happy? "/>
                        <Run Text="Set your password" Foreground="{StaticResource GoldLightBrush}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button Content="Got it" Style="{StaticResource GoldButton}" Click="GotIt_Click"/>
        </StackPanel>
    </Border>
</Window>
