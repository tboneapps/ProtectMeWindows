<Application x:Class="ProtectMe.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProtectMe.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:ExeToIconConverter x:Key="ExeToIconConverter"/>
        <!-- Exact ProtectMe Black & Gold Design Tokens -->
        <SolidColorBrush x:Key="BgBrush" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#25221D"/>
        <SolidColorBrush x:Key="CardBorderActiveBrush" Color="#61D4AF37"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#D4AF37"/>
        <SolidColorBrush x:Key="GoldLightBrush" Color="#F5D77A"/>
        <SolidColorBrush x:Key="InkBrush" Color="#F3E7C4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8C8472"/>
        <SolidColorBrush x:Key="DimBrush" Color="#4A463E"/>
        <SolidColorBrush x:Key="LabelGoldBrush" Color="#B9A673"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E06A5A"/>
        <SolidColorBrush x:Key="DangerBgBrush" Color="#1A0F0E"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#3A2220"/>

        <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#181818" Offset="0"/>
            <GradientStop Color="#101010" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0CE63" Offset="0"/>
            <GradientStop Color="#C99F2B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TitleGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FBE7A6" Offset="0"/>
            <GradientStop Color="#D4AF37" Offset="0.5"/>
            <GradientStop Color="#A8842A" Offset="1"/>
        </LinearGradientBrush>

        <FontFamily x:Key="CinzelFont">pack://application:,,,/Assets/Fonts/#Cinzel</FontFamily>
        <FontFamily x:Key="ManropeFont">pack://application:,,,/Assets/Fonts/#Manrope</FontFamily>

        <Style x:Key="PmCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGradientBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldGradientBrush}"/>
            <Setter Property="Foreground" Value="#0A0A0A"/>
            <Setter Property="FontFamily" Value="{StaticResource ManropeFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineGoldButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource ManropeFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource ManropeFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PmTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource ManropeFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="PmCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource ManropeFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Luxury Gold Pill Toggle Switch (ProtectMe Style) -->
        <Style x:Key="GoldToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="48" Height="26">
                            <Border x:Name="Track"
                                    CornerRadius="13"
                                    Background="#1D1B17"
                                    BorderBrush="#332E24"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="Thumb"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     Fill="#8C8472"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource GoldGradientBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GoldLightBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#0A0A0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sleek Black & Gold ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" CornerRadius="4" Background="#66D4AF37" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#D4AF37"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
