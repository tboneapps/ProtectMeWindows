<Window x:Class="ProtectMe.App.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Password"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Background="#0A0A0A">
    <Border Margin="16" Style="{StaticResource PmCard}">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="MASTER PASSWORD"
                       FontFamily="{StaticResource CinzelFont}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="PromptText"
                       Text="Enter your master password to continue."
                       FontFamily="{StaticResource ManropeFont}"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>
            <PasswordBox x:Name="PasswordInput"
                         Background="#0A0A0A"
                         Foreground="#F3E7C4"
                         CaretBrush="#D4AF37"
                         BorderBrush="#25221D"
                         BorderThickness="1"
                         Padding="12,10"
                         FontSize="15"
                         Margin="0,0,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OutlineGoldButton}" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Confirm" Style="{StaticResource GoldButton}" IsDefault="True" Click="Confirm_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
