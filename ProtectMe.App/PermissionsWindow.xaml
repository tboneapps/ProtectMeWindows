<Window x:Class="ProtectMe.App.PermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProtectMe — Permissions Needed"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0A0A0A">
    <Border Margin="18" Style="{StaticResource PmCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="PERMISSIONS NEEDED"
                           FontFamily="{StaticResource CinzelFont}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TitleGradientBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="ProtectMe needs these Windows permissions so app blocking, website whitelist-only mode, and anti-tamper protection cannot be bypassed:"
                           FontFamily="{StaticResource ManropeFont}"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <!-- 1. Windows SYSTEM Service -->
                <Border Background="#0A0A0A" BorderBrush="#25221D" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Windows SYSTEM Service" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Runs in background as LocalSystem to block apps, guard Task Manager, and prevent tampering." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ServiceStatusBadge" Text="MISSING" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                            <Button x:Name="GrantServiceBtn" Content="Grant &amp; Install" Style="{StaticResource GoldButton}" Padding="12,6" FontSize="12" Click="GrantService_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. System Proxy Enforcement -->
                <Border Background="#0A0A0A" BorderBrush="#25221D" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Network / Website Whitelist Proxy" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Required to block all websites except your whitelist and show the Allow Site / Allow Page popup." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="ProxyStatusBadge" Grid.Column="1" Text="READY" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 3. Master Password -->
                <Border Background="#0A0A0A" BorderBrush="#25221D" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Master Password Lock" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Required to unlock protection, change rules while locked, and uninstall ProtectMe." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PasswordStatusBadge" Text="MISSING" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                            <Button x:Name="SetPasswordBtn" Content="Set Password" Style="{StaticResource OutlineGoldButton}" Padding="12,6" FontSize="12" Click="SetPassword_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Re-check" Style="{StaticResource OutlineGoldButton}" Click="Recheck_Click"/>
                <Button Grid.Column="2" Content="Continue" Style="{StaticResource GoldButton}" Click="Continue_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
