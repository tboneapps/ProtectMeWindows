<Window x:Class="ProtectMe.App.GraceLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="10-Second Login"
        Width="380" Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="24" BorderBrush="#66D4AF37" BorderThickness="1.2" Padding="24">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#241E12" Offset="0"/>
                <GradientStop Color="#12100C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel VerticalAlignment="Center">
            <!-- App Circle Badge with Clock -->
            <Grid Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Border Width="64" Height="64" CornerRadius="32" Background="#161410" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2">
                    <TextBlock x:Name="AppBadgeText" Text="App" Foreground="{StaticResource GoldLightBrush}" FontSize="11" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6"/>
                </Border>
                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource GoldGradientBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="⏱" Foreground="#0A0A0A" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <TextBlock x:Name="AppNameText" Text="App" Foreground="{StaticResource MutedBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="10-SECOND LOGIN?"
                       FontFamily="{StaticResource CinzelFont}"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TitleGradientBrush}"
                       HorizontalAlignment="Center"/>

            <!-- Gold Diamond Ornament -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,16">
                <Border Width="34" Height="1" Background="#55D4AF37" VerticalAlignment="Center"/>
                <Rectangle Width="5" Height="5" Fill="{StaticResource GoldBrush}" Margin="8,0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                </Rectangle>
                <Border Width="34" Height="1" Background="#55D4AF37" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Gives 10 seconds of internet each time you open it, so it can sign in to your account."
                       Foreground="{StaticResource InkBrush}" FontSize="13" Opacity="0.85" TextAlignment="Center" TextWrapping="Wrap" Margin="6,0,6,8"/>
            <TextBlock Text="Then it goes offline."
                       Foreground="{StaticResource GoldLightBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>

            <!-- Timeline Pill: Open app —— [10s online] —— Offline -->
            <Border Background="#12100C" BorderBrush="#2E281C" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Open app" Foreground="{StaticResource InkBrush}" FontSize="11"/>
                    </StackPanel>
                    <Border Grid.Column="1" Height="1.5" Background="#88D4AF37" VerticalAlignment="Center" Margin="6,0"/>
                    <Border Grid.Column="2" Background="{StaticResource GoldGradientBrush}" CornerRadius="10" Padding="10,4">
                        <TextBlock Text="10s online" Foreground="#0A0A0A" FontSize="11" FontWeight="ExtraBold"/>
                    </Border>
                    <Border Grid.Column="3" Height="1.5" Background="#55D4AF37" VerticalAlignment="Center" Margin="6,0"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#555" Margin="0,0,6,0"/>
                        <TextBlock Text="Offline" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Content="ADD 10 SECONDS  →" Style="{StaticResource GoldButton}" Margin="0,0,0,12" Click="Add10s_Click"/>
            <Button Content="Not now" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="13" Cursor="Hand" Click="NotNow_Click"/>
        </StackPanel>
    </Border>
</Window>
