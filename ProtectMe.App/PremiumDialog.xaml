<Window x:Class="ProtectMe.App.PremiumDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProtectMe Websites Pro"
        Width="390" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="26" BorderBrush="#88D4AF37" BorderThickness="1.4" Padding="24">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#261F11" Offset="0"/>
                <GradientStop Color="#12100B" Offset="0.55"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel VerticalAlignment="Center">
            <!-- Official ProtectMe Gold Shield -->
            <Image Source="pack://application:,,,/Assets/Images/protectme_icon.png"
                   Width="72" Height="72"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

            <TextBlock Text="W E B S I T E S   P R O"
                       FontFamily="{StaticResource CinzelFont}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TitleGradientBrush}"
                       HorizontalAlignment="Center"/>

            <!-- Gold Diamond Ornament -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,14">
                <Border Width="38" Height="1" Background="#66D4AF37" VerticalAlignment="Center"/>
                <Rectangle Width="5" Height="5" Fill="{StaticResource GoldBrush}" Margin="8,0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                </Rectangle>
                <Border Width="38" Height="1" Background="#66D4AF37" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="SubtitleText"
                       Text="Your 7-day free trial of Website Protection has ended."
                       Foreground="{StaticResource GoldLightBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="4,0,4,10"/>

            <TextBlock Text="App blocking, offline mode, schedules, and password protection stay 100% free forever. Only the Websites suite requires an annual pass — no account needed."
                       Foreground="{StaticResource InkBrush}"
                       Opacity="0.82"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="4,0,4,16"/>

            <!-- Price Pill -->
            <Border Background="#18140C" BorderBrush="#55D4AF37" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="£10 / YEAR" FontFamily="{StaticResource CinzelFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Instant license key · Locked to your PC · No account required" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Purchase CTA -->
            <Button Content="UNLOCK WEBSITES — £10 / YEAR  →" Style="{StaticResource GoldButton}" Margin="0,0,0,16" Click="BuyNow_Click"/>

            <!-- Already Have a Key or Promo Code? -->
            <TextBlock Text="LICENSE KEY OR PROMO CODE" Foreground="{StaticResource LabelGoldBrush}" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LicenseKeyBox" Grid.Column="0" Style="{StaticResource PmTextBox}" Padding="10,9" FontSize="12" ToolTip="Paste your Gumroad license key or promo code"/>
                <Button x:Name="ActivateBtn" Grid.Column="2" Content="Activate" Style="{StaticResource OutlineGoldButton}" Padding="14,9" FontSize="12" Click="Activate_Click"/>
            </Grid>

            <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource DangerBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MinHeight="16" Margin="0,0,0,6"/>

            <Button Content="Maybe later" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="12" Cursor="Hand" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
